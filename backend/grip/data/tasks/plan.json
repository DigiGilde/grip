          "done_when": "quote_offered",
          "assignee": "owner",
          "link": "/opdrachten/{assignment_id}/offerte"
        },
        {
          "key": "offerte.wacht_op_akkoord",
          "track": "offerte",
          "title": "Wacht op akkoord van de opdrachtgever",
