{
  "version": "2026.3",
  "replaces": [
    "2026.2"
  ],
  "description": "Het meegeleverde plan. Een taak ontstaat als alles onder 'when' waar is en sluit zodra het feit onder 'done_when' waar is. Namen van onderwerpen ('for'), feiten en rollen komen uit de catalogus in grip/tasks/catalogue.py; het plan kan er geen bedenken. Onder 'courses' staat per soort zaak het verloop: de stappen, het feit dat een stap afrondt en de taken die bij de stap horen.",
  "case_kinds": {
    "assignment": {
      "tracks": [
        {
          "key": "offerte",
          "label": "Offerte"
        },
        {
          "key": "bemensing",
          "label": "Bemensing"
        },
        {
          "key": "uitvoering",
          "label": "Uitvoering"
        },
        {
          "key": "financien",
          "label": "Financiën"
        }
      ],
      "templates": [
        {
          "key": "offerte.aanvraag_uitwerken",
          "track": "offerte",
          "title": "Werk de aanvraag uit: maak de begroting",
          "for": "case",
          "when": [
            "contractor",
            "external",
            "potential"
          ],
          "done_when": "budget_has_line",
          "assignee": "owner",
          "link": "/opdrachten/{assignment_id}/begroting"
        },
        {
          "key": "offerte.opstellen",
          "track": "offerte",
          "title": "Stel de offerte op",
          "for": "quote_round",
          "when": [
            "contractor",
            "external",
            "potential",
            "budget_has_line",
            "not quote_rejected_before",
            "not quote_sent_back"
          ],
          "done_when": "quote_fresh",
          "assignee": "owner",
          "link": "/opdrachten/{assignment_id}/offerte"
        },
        {
          "key": "offerte.goedkeuring_vragen",
          "track": "offerte",
          "title": "Vraag interne goedkeuring voor de offerte",
          "for": "quote_round",
          "when": [
            "contractor",
            "external",
            "potential",
            "quote_fresh",
            "approval_needed"
          ],
          "done_when": "approval_asked",
          "assignee": "owner",
          "link": "/opdrachten/{assignment_id}/offerte"
        },
        {
          "key": "offerte.intern_beoordelen",
          "track": "offerte",
          "title": "Beoordeel offerte {kenmerk}",
          "for": "quote_approval",
          "when": [
            "contractor"
          ],
          "done_when": "approval_decided",
          "assignee": "offertegoedkeurder",
