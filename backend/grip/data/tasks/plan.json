          "title": "Vul de rol {rol} in",
          "for": "open_role",
          "when": [
            "contractor",
            "not closed",
            "staffing_in_view"
          ],
          "done_when": "role_staffed",
          "assignee": "planner",
          "link": "/opdrachten/{assignment_id}/bemensing"
        },
        {
          "key": "intern.begroten",
          "track": "uitvoering",
          "title": "Maak de begroting",
          "for": "case",
          "when": [
            "contractor",
            "not external",
            "potential"
          ],
          "done_when": "budget_has_line",
          "assignee": "owner",
          "link": "/opdrachten/{assignment_id}/begroting"
        },
        {
          "key": "intern.starten",
          "track": "uitvoering",
          "title": "Start de opdracht",
          "for": "case",
          "when": [
            "contractor",
            "not external",
            "budget_has_line",
            "not started",
            "not closed"
          ],
          "done_when": "started",
          "assignee": "owner",
          "link": "/opdrachten/{assignment_id}"
        },
        {
          "key": "uitvoering.starten",
          "track": "uitvoering",
          "title": "Zet de opdracht in uitvoering",
          "for": "case",
          "when": [
            "contractor",
            "external",
            "agreed"
          ],
          "done_when": "started",
          "assignee": "owner",
          "link": "/opdrachten/{assignment_id}"
        },
        {
          "key": "uitvoering.maand_afsluiten",
          "track": "uitvoering",
          "title": "Sluit {maand} af",
          "for": "month_to_close",
          "only_first": true,
          "when": [
            "contractor",
            "may_close_months"
          ],
          "done_when": "month_closed",
          "assignee": "manager",
          "due": {
            "working_days": 5,
            "after": "month_end"
          },
          "link": "/opdrachten/{assignment_id}/maandafsluiting?maand={repeat_key}"
        },
        {
          "key": "uitvoering.eindrapport",
          "track": "uitvoering",
          "title": "Lever het eindrapport op",
          "for": "case",
          "when": [
            "contractor",
            "external",
            "completed"
          ],
          "done_when": "final_report_issued",
          "assignee": "owner",
          "link": "/rapportage/opdrachten/{assignment_id}"
        },
        {
          "key": "financien.factuurgegevens_aanleveren",
          "track": "financien",
          "title": "Lever {periode} aan",
          "for": "billing_period",
          "only_first": true,
          "when": [
            "contractor",
            "external",
            "may_bill",
            "period_ready"
          ],
          "done_when": "period_delivered",
          "assignee": "manager",
          "due": {
            "working_days": 5,
            "after": "ready_on"
          },
          "link": "/opdrachten/{assignment_id}/maandafsluiting?periode={repeat_key}"
        },
        {
          "key": "financien.factuur_vastleggen",
          "track": "financien",
          "title": "Leg de factuur over {periode} vast",
          "for": "billing_period",
          "only_first": true,
          "when": [
            "contractor",
            "external",
            "may_bill",
            "period_delivered"
          ],
          "done_when": "period_invoiced",
          "assignee": "manager",
          "due": {
            "working_days": 10,
            "after": "delivered_on"
          },
          "link": "/opdrachten/{assignment_id}/maandafsluiting?factuur={subject_id}"
        },
        {
          "key": "financien.naverrekening_aanleveren",
          "track": "financien",
          "title": "Lever de naverrekening over {periode} aan",
          "for": "correction_month",
          "when": [
            "contractor",
            "external",
            "may_bill"
          ],
          "done_when": "correction_delivered",
          "assignee": "manager",
          "due": {
            "working_days": 5,
            "after": "correction_arose_on"
          },
          "link": "/opdrachten/{assignment_id}/maandafsluiting?maand={repeat_key}",
          "requires_event": "billing_correction.arose"
