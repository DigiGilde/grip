          "when": [
            "contractor",
            "potential"
          ],
          "done_when": "quote_superseded",
          "assignee": "maker",
          "link": "/opdrachten/{assignment_id}/begroting",
          "requires_event": "quote_approval.sent_back"
        },
        {
          "key": "offerte.aanbieden",
          "track": "offerte",
          "title": "Bied de offerte aan",
          "for": "quote_round",
          "when": [
            "contractor",
            "external",
            "potential",
            "quote_fresh",
            "quote_may_offer"
