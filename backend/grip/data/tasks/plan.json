            "working_days": 3,
            "after": "approval_requested_on"
          },
          "link": "/opdrachten/{assignment_id}/offerte",
          "requires_event": "quote_approval.requested"
        },
        {
          "key": "offerte.na_terugsturen_opnieuw_maken",
          "track": "offerte",
          "title": "Maak een nieuwe offerte: {kenmerk} is teruggestuurd",
