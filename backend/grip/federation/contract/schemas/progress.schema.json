{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voortgang",
  "description": "Status en voortgang van een opdracht. Geen bedragen en geen namen (gegevensklasse A).",
  "type": "object",
  "properties": {
    "assignment_uri": {
      "type": "string",
      "format": "uri",
      "description": "URI van de opdracht."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "requested",
        "quoted",
        "accepted",
        "in_progress",
        "completed",
        "accounted",
        "rejected",
        "cancelled"
      ],
      "description": "Status van de opdracht."
    },
    "as_of": {
      "type": "string",
      "format": "date",
      "description": "Datum waarop deze stand geldt."
    },
    "summary": {
      "type": "string",
      "description": "Korte stand van zaken."
    },
    "milestones": {
      "type": "array",
      "description": "Mijlpalen.",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Omschrijving van de mijlpaal."
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Geplande datum."
          },
          "state": {
            "type": "string",
            "enum": [
              "planned",
              "done",
              "dropped"
            ],
            "description": "Stand van de mijlpaal."
          }
        },
        "required": [
          "description",
          "state"
        ]
      }
    },
    "delivered": {
      "type": "array",
      "description": "Wat is geleverd.",
      "items": {
        "type": "string"
      }
    },
    "not_delivered": {
      "type": "array",
      "description": "Wat niet is geleverd.",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "assignment_uri",
    "status",
    "as_of"
  ]
}
