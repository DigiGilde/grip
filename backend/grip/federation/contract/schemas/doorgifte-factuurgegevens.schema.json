{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doorgifte: factuurgegevens",
  "description": "Factuurgegevens van alle opdrachten in een maand, voor de moederinstantie (gegevensklasse B).",
  "type": "object",
  "properties": {
    "maand": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "description": "Maand, als JJJJ-MM."
    },
    "resultaten": {
      "type": "array",
      "description": "Factuurgegevens per opdracht.",
      "items": {
        "$ref": "factuurgegevens.schema.json"
      }
    }
  },
  "required": [
    "maand",
    "resultaten"
  ]
}
