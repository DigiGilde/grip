{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doorgifte: bezetting",
  "description": "Bemensing met namen, alleen voor de moederinstantie (gegevensklasse C). Gaat nooit naar een opdrachtgever.",
  "type": "object",
  "properties": {
    "period": {
      "$ref": "period.schema.json"
    },
    "results": {
      "type": "array",
      "description": "Inzet per persoon per opdracht.",
      "items": {
        "type": "object",
        "properties": {
          "assignment_uri": {
            "type": "string",
            "format": "uri",
            "description": "URI van de opdracht."
          },
          "person": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Naam."
              },
              "email": {
                "type": "string",
                "format": "email",
                "description": "E-mailadres; sleutel voor koppelen."
              }
            },
            "required": [
              "name"
            ]
          },
          "role": {
            "type": "string",
            "description": "Rol op de opdracht."
          },
          "fte_pct": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$",
            "description": "Inzet als percentage van een FTE. Exacte decimaal als tekst, geen floating point."
          },
          "period": {
            "$ref": "period.schema.json"
          }
        },
        "required": [
          "assignment_uri",
          "person",
          "fte_pct",
          "period"
        ]
      }
    }
  },
  "required": [
    "period",
    "results"
  ]
}
