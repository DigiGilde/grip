{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Node",
  "description": "Een node uit een corpus, zoals die gold op de peildatum.",
  "type": "object",
  "properties": {
    "uri": {
      "type": "string",
      "format": "uri",
      "description": "URI van de node, uitgegeven door het corpus dat de node beheert: {corpus}/id/node/{uuid}."
    },
    "type": {
      "description": "Type van de node: een id uit de kernlijst in vocabulaire/, of de volledige URI van een eigen type in een eigen naamruimte.",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "dossier",
            "doel",
            "instrument",
            "beleidskader",
            "maatregel",
            "politieke_input",
            "probleem",
            "effect",
            "beleidsoptie",
            "bron"
          ]
        },
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      ]
    },
    "title": {
      "type": "string",
      "description": "Titel op de peildatum."
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "description": "Omschrijving."
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "description": "Status op de peildatum, bijvoorbeeld actief."
    },
    "validity": {
      "$ref": "period.schema.json"
    },
    "managing_organisation": {
      "anyOf": [
        {
          "$ref": "organisation-ref.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "corpus": {
      "type": "string",
      "format": "uri",
      "description": "Basis-URI van het corpus dat deze node beheert."
    },
    "peildatum": {
      "type": "string",
      "format": "date",
      "description": "Datum waarop titel en status gelden."
    },
    "type_details": {
      "type": "object",
      "description": "Kleine uitbreiding per type. Verplicht voor politieke_input en instrument."
    }
  },
  "required": [
    "uri",
    "type",
    "title",
    "status",
    "corpus",
    "peildatum"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "politieke_input"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "type_details"
        ],
        "properties": {
          "type_details": {
            "type": "object",
            "properties": {
              "soort": {
                "type": "string",
                "description": "Soort politieke input, bijvoorbeeld coalitieakkoord, motie, kamerbrief, toezegging, amendement, kamervraag, commissiedebat, schriftelijk_overleg of interpellatie."
              },
              "referentie": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Verwijzing, bijvoorbeeld een kamerstuknummer."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "datum": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date",
                "description": "Datum van de politieke input."
              }
            },
            "required": [
              "soort"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "instrument"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "type_details"
        ],
        "properties": {
          "type_details": {
            "type": "object",
            "properties": {
              "soort": {
                "type": "string",
                "enum": [
                  "wetgeving",
                  "subsidie",
                  "voorlichting",
                  "handhaving",
                  "overig"
                ],
                "description": "Soort instrument."
              }
            },
            "required": [
              "soort"
            ]
          }
        }
      }
    }
  ]
}
