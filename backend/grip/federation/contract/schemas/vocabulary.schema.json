{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Woordenlijst",
  "description": "Node-typen en edge-typen met hun URI. De kernlijst staat in vocabulaire/; een corpus mag eigen typen toevoegen in een eigen naamruimte.",
  "type": "object",
  "properties": {
    "namespace": {
      "type": "string",
      "format": "uri",
      "description": "Naamruimte van de typen in deze lijst."
    },
    "node_types": {
      "type": "array",
      "description": "Node-typen.",
      "items": {
        "$ref": "#/$defs/type_definition"
      }
    },
    "edge_types": {
      "type": "array",
      "description": "Edge-typen.",
      "items": {
        "$ref": "#/$defs/type_definition"
      }
    }
  },
  "required": [
    "namespace",
    "node_types",
    "edge_types"
  ],
  "$defs": {
    "type_definition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Korte naam van het type.",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "description": "URI van het type."
        },
        "label_nl": {
          "type": "string",
          "description": "Nederlandse naam."
        },
        "description": {
          "type": "string",
          "description": "Betekenis."
        },
        "custom": {
          "type": "boolean",
          "description": "True voor een eigen type buiten de kernlijst."
        }
      },
      "required": [
        "id",
        "uri",
        "label_nl",
        "description"
      ]
    }
  }
}
