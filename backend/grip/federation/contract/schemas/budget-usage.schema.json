{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Uitputting",
  "description": "Begroot, uitputting en beschikbaar voor een opdracht (gegevensklasse B). Alleen op verzoek en alleen met een contract dat dit toestaat.",
  "type": "object",
  "properties": {
    "assignment_uri": {
      "type": "string",
      "format": "uri",
      "description": "URI van de opdracht."
    },
    "as_of": {
      "type": "string",
      "format": "date",
      "description": "Datum waarop deze stand geldt."
    },
    "year": {
      "anyOf": [
        {
          "type": "integer",
          "description": "Kalenderjaar waarop is gefilterd; null voor de hele looptijd."
        },
        {
          "type": "null"
        }
      ]
    },
    "budgeted": {
      "$ref": "money.schema.json"
    },
    "used": {
      "$ref": "money.schema.json"
    },
    "available": {
      "$ref": "money.schema.json"
    },
    "lines": {
      "type": "array",
      "description": "Stand per begrotingsregel, zonder personen.",
      "items": {
        "$ref": "#/$defs/usage_line"
      }
    }
  },
  "required": [
    "assignment_uri",
    "as_of",
    "budgeted",
    "used",
    "available"
  ],
  "$defs": {
    "usage_line": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "Omschrijving van de begrotingsregel."
        },
        "budgeted": {
          "$ref": "money.schema.json"
        },
        "used": {
          "$ref": "money.schema.json"
        },
        "available": {
          "$ref": "money.schema.json"
        }
      },
      "required": [
        "description",
        "budgeted",
        "used",
        "available"
      ]
    }
  }
}
