{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opdracht",
  "description": "Kerngegevens van een opdracht (gegevensklasse A).",
  "type": "object",
  "properties": {
    "uri": {
      "type": "string",
      "format": "uri",
      "description": "URI van de opdracht, uitgegeven door de instantie die hem aanmaakte: {basis}/id/opdracht/{uuid}."
    },
    "name": {
      "type": "string",
      "description": "Naam van de opdracht."
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "description": "Omschrijving."
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "external",
        "internal"
      ],
      "description": "external: met een opdrachtgever; internal: uit eigen middelen."
    },
    "client": {
      "anyOf": [
        {
          "$ref": "organisation-ref.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "contractor": {
      "$ref": "organisation-ref.schema.json"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "requested",
        "quoted",
        "accepted",
        "in_progress",
        "completed",
        "accounted",
        "rejected",
        "cancelled"
      ],
      "description": "draft (concept), requested (aangevraagd), quoted (offerte uitgegeven), accepted (akkoord), in_progress (in uitvoering), completed (afgerond), accounted (verantwoord), rejected (afgewezen), cancelled (geannuleerd)."
    },
    "period": {
      "$ref": "period.schema.json"
    },
    "parent_assignment_uri": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "description": "URI van de bovenliggende opdracht als deze opdracht is doorgezet in een keten."
        },
        {
          "type": "null"
        }
      ]
    },
    "context_refs": {
      "type": "array",
      "description": "URIs van de nodes waar de opdracht uit voortkomt. Mag leeg zijn. Mag nodes uit meerdere corpora bevatten.",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "uri",
    "name",
    "contractor",
    "status",
    "context_refs"
  ]
}
