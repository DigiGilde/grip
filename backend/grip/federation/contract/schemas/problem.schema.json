{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foutmelding",
  "description": "Foutmelding volgens RFC 9457 (application/problem+json).",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "format": "uri-reference",
      "description": "URI die het soort fout aanduidt."
    },
    "title": {
      "type": "string",
      "description": "Korte omschrijving van het soort fout."
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599,
      "description": "HTTP-statuscode."
    },
    "detail": {
      "type": "string",
      "description": "Toelichting op deze fout. Geen technische details."
    },
    "instance": {
      "type": "string",
      "format": "uri-reference",
      "description": "URI van dit voorval."
    }
  },
  "required": [
    "title",
    "status",
    "detail"
  ]
}
