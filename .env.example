# Copy to .env for local overrides. docker-compose and the justfile work
# without it: the defaults below are the local development values.

# --- Instance identity ------------------------------------------------------
INSTANCE_NAME=Grip (lokaal)
# Base of every URI this instance mints: {base}/id/opdracht/{uuid}
INSTANCE_BASE_URI=http://localhost:8010
# TOOI URI of the nearest registered organisation
INSTANCE_TOOI_URI=
# Own identifier, for an instance smaller than a registered organisation
INSTANCE_KEY=lokaal
# Base URI of the parent instance, if any
PARENT_INSTANCE_URI=

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://grip:grip@localhost:5434/grip

# --- Authentication ---------------------------------------------------------
# Local development runs without an identity provider. The app refuses to
# start without OIDC unless this is set, and refuses it when deployed.
DEV_NO_AUTH=1

# To log in through Keycloak (SSO Rijk) instead: remove DEV_NO_AUTH and set
# these. The client is confidential, with two redirect URIs:
# {FRONTEND_URL}/api/auth/callback (login through the proxied /api) and
# {BACKEND_URL}/api/auth/callback (login straight at the backend).
# OIDC_ISSUER=https://<keycloak-host>/realms/<realm>
# OIDC_CLIENT_ID=grip
# OIDC_CLIENT_SECRET=
# SESSION_SECRET_KEY=<long random value, e.g. `openssl rand -base64 48`>

# Email addresses that get the beheerder function at startup (comma-separated).
# This is how the first beheerder of an instance comes to exist.
BOOTSTRAP_BEHEERDER_EMAILS=

# --- URLs -------------------------------------------------------------------
# FRONTEND_URL is the origin the browser uses. The dev server and the nginx
# container both proxy /api to the backend, so the API is reachable on this
# origin too. BACKEND_URL is the backend's own origin.
FRONTEND_URL=http://localhost:5183
BACKEND_URL=http://localhost:8010

# Proxies in front of the backend, as comma-separated IP addresses or CIDR
# ranges. Only from these are X-Forwarded-Proto, X-Forwarded-Host and
# X-Forwarded-For believed. Empty means none. When deployed, set it to the
# address range of the frontend's nginx container.
TRUSTED_PROXIES=
