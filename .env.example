# Copy to .env for local overrides. docker-compose and the justfile work
# without it: the defaults below are the local development values.

# --- Instance identity ------------------------------------------------------
INSTANCE_NAME=Grip (lokaal)
# Base of every URI this instance mints: {base}/id/opdracht/{uuid}
INSTANCE_BASE_URI=http://localhost:8010
# TOOI URI of the nearest registered organisation
INSTANCE_TOOI_URI=
# Own identifier, for an instance smaller than a registered organisation
INSTANCE_KEY=lokaal
# Base URI of the parent instance, if any
PARENT_INSTANCE_URI=

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://grip:grip@localhost:5434/grip

# --- Authentication ---------------------------------------------------------
# Local development runs without an identity provider. The app refuses to
# start without OIDC unless this is set, and refuses it when deployed.
DEV_NO_AUTH=1

# To log in through Keycloak (SSO Rijk) instead: remove DEV_NO_AUTH and set
# these. The client is confidential, with two redirect URIs:
# {FRONTEND_URL}/api/auth/callback (login through the proxied /api) and
# {BACKEND_URL}/api/auth/callback (login straight at the backend).
# OIDC_ISSUER=https://<keycloak-host>/realms/<realm>
# OIDC_CLIENT_ID=grip
# OIDC_CLIENT_SECRET=
# SESSION_SECRET_KEY=<long random value, e.g. `openssl rand -base64 48`>
# The identity provider must be reached over https. The app refuses to start
# otherwise. For a local provider over http (a Keycloak in a container) only:
# OIDC_ALLOW_INSECURE_HTTP=1
# Show, masked, what the provider sent at a login on /api/auth/diagnose. For a
# first login on a developer's machine (`just sso-check`); refused when deployed.
# OIDC_DIAGNOSTICS=1

# Email addresses that get the beheerder function at startup (comma-separated).
# This is how the first beheerder of an instance comes to exist.
BOOTSTRAP_BEHEERDER_EMAILS=

# --- URLs -------------------------------------------------------------------
# FRONTEND_URL is the origin the browser uses. The dev server and the nginx
# container both proxy /api to the backend, so the API is reachable on this
# origin too. BACKEND_URL is the backend's own origin.
FRONTEND_URL=http://localhost:5183
BACKEND_URL=http://localhost:8010

# Proxies in front of the backend, as comma-separated IP addresses or CIDR
# ranges. Only from these are X-Forwarded-Proto, X-Forwarded-Host and
# X-Forwarded-For believed. Empty means none. When deployed, set it to the
# address range of the frontend's nginx container.
TRUSTED_PROXIES=

# --- Deployed instances -----------------------------------------------------
# Set by the hosting platform; leave them out locally.
# PUBLIC_HOST: public origin of this component; URLs and cookie settings are
# derived from it, and DEV_NO_AUTH is refused when it is set.
# PUBLIC_HOST=
# OIDC_URL + OIDC_REALM: alternative to OIDC_ISSUER.
# OIDC_URL=
# OIDC_REALM=
# OIDC_DISCOVERY_URL: discovery document, when it is not at the usual place.
# OIDC_DISCOVERY_URL=
# The database as separate values, alternative to DATABASE_URL.
# DATABASE_SERVER_HOST=
# DATABASE_SERVER_PORT=
# DATABASE_SERVER_USER=
# DATABASE_PASSWORD=
# DATABASE_DB=
# DATABASE_SCHEMA=
# Session cookie: domain, Secure flag and lifetime (default seven days).
# SESSION_COOKIE_DOMAIN=
# SESSION_COOKIE_SECURE=true
# SESSION_TTL_SECONDS=604800

# Passkeys. The relying party follows from FRONTEND_URL; set these only when
# it must differ. See docs/passkeys-en-installeren.md.
# PASSKEY_RP_ID=
# PASSKEY_ORIGIN=
# PASSKEY_SESSION_TTL_SECONDS=43200
# Days after the last login through the identity provider that a passkey
# alone can log in. 0 switches logging in with a passkey off.
# PASSKEY_LOGIN_MAX_AGE_DAYS=30

# Notifications on people's own devices (web push). The key pair of the
# instance, a secret: make one with `just push-key`. Empty: no notifications.
# Changing it ends every subscription. See docs/meldingen.md.
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=mailto:beheer@example.org
# PUSH_DAILY_CAP=6
# Origins allowed by CORS, as a JSON list. Default: FRONTEND_URL.
# CORS_ORIGINS=["https://grip.example"]
# Name in the API docs and log lines; DEBUG adds SQL and tracebacks to the log.
# APP_NAME=Grip
# DEBUG=false

# --- Vacancies and the language model ---------------------------------------
# Mail (the signing link of a quote). Everything else works without it.
# On the hosting platform the send-email service sets these five after an
# administrator approved it; the relay writes the From address itself.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TLS: starttls (default), tls or none (a local mail catcher only).
# SMTP_TLS=starttls
# SMTP_TLS_VERIFY: the relay's certificate is checked unless this is false;
# SMTP_TLS_CA_FILE names the certificate authority to check it against.
# SMTP_TLS_VERIFY=true
# SMTP_TLS_CA_FILE=

# Which model drafts texts: empty (VLAM when configured), vlam, none, or
# claude_cli. claude_cli runs the command-line tool on your own machine with
# your own login; local development only, refused when deployed (ADR 0035).
# LLM_PROVIDER=
# CLAUDE_CLI_MODEL=sonnet
# The shipped library of standard vacancy texts to load at start; empty
# loads none (docs/vacatureteksten.md).
# VACANCY_TEXT_PROFILE=digigilde
# Drafting vacancy texts uses VLAM. Everything else works without it.
# VLAM_API_URL: base address without path, injected by the platform's vlam service.
# VLAM_API_URL=
# VLAM_BASE_URL: manual address including /v1, for local work.
# VLAM_BASE_URL=
# VLAM_API_KEY: the instance's own key.
# VLAM_API_KEY=
# VLAM_MODEL_ID: the model to use; pick one from the list the service offers.
# VLAM_MODEL_ID=
# A few sentences about the organisation, sent along when a text is drafted.
# VACANCY_ORGANISATION_DESCRIPTION=

# --- Wies -------------------------------------------------------------------
# Everything is off while these are empty.
# WIES_BASE_URL + WIES_API_KEY: grip reads colleagues from Wies.
# WIES_BASE_URL=
# WIES_API_KEY=
# GRIP_EXPORT_KEY: the key Wies presents to fetch assignments and placements.
# GRIP_EXPORT_KEY=
# WIES_SUBORGANIZATIONS: comma-separated merken of Wies this instance takes
# people from. Empty means every merk.
# WIES_SUBORGANIZATIONS=
# WIES_DEFAULT_SUBORGANIZATION: the merk under which grip proposes a new
# colleague to Wies when none is given with the hire.
# WIES_DEFAULT_SUBORGANIZATION=
# PROSPECTIVE_RETENTION_DAYS: days a person record is kept after a recorded
# hire fell through. Have the privacy officer confirm the term.
# PROSPECTIVE_RETENTION_DAYS=28

# --- Federation (FSC) -------------------------------------------------------
# Both directions are off by default.
# FEDERATION_INBOUND_ENABLED: accept messages on the federation listener.
# FEDERATION_INBOUND_ENABLED=false
# FEDERATION_OUTBOUND_ENABLED: send outbox messages; needs OUTWAY_URL.
# FEDERATION_OUTBOUND_ENABLED=false
# OUTWAY_URL: address of this instance's FSC outway.
# OUTWAY_URL=
# FSC_PEER_ID_HEADER: header in which the inway passes on who is calling.
# FSC_PEER_ID_HEADER=Fsc-Request-Peer-Id
# FEDERATION_SIGNING_KEY: private key (PEM) for signing an acceptance.
# FEDERATION_SIGNING_KEY=
# FEDERATION_SIGNING_KID: key id published with the public key.
# FEDERATION_SIGNING_KID=
# FEDERATION_RETIRED_JWKS: public keys no longer used for signing, still published.
# FEDERATION_RETIRED_JWKS=
# Outbox: seconds between rounds, attempts before giving up, timeout per call.
# FEDERATION_OUTBOX_INTERVAL_SECONDS=15
# FEDERATION_MAX_ATTEMPTS=12
# FEDERATION_HTTP_TIMEOUT_SECONDS=20
# How long the keys of a peer and a node from a corpus are cached.
# FEDERATION_JWKS_TTL_SECONDS=3600
# CORPUS_CACHE_TTL_SECONDS=300

# RATE_INDEXATION_DEFAULT_PCT: the percentage a new rate card is proposed to go
# up by when it starts as a copy of an earlier year (0 to 25).
# RATE_INDEXATION_DEFAULT_PCT=5

# The organisation as it signs its documents. A quote is sent by the
# organisation, not by the software: this name stands on it as the sender.
# Empty falls back to INSTANCE_NAME.
ORGANISATION_NAME=
# What the organisation is part of, as further lines of the letterhead,
# separated by "|".
LETTERHEAD_LINES=
# Only for an organisation that may carry the Rijkslogo: the path of the SVG
# with the Rijkslint and the coat of arms. The design system package ships it
# as favicon.svg; point to that file, do not copy it. Empty gives a plain head.
LETTERHEAD_LOGO_PATH=
# Only for an organisation that may use the Rijkshuisstijl typeface: the
# directory with RijksSansWeb-Regular.woff2 (the design system's dist/fonts).
# Empty sets documents in Verdana or the nearest sans-serif.
DOCUMENT_FONT_DIR=
# Prefix of the reference of a quote, as in "DG-2026-0007". Empty derives it
# from INSTANCE_KEY.
QUOTE_REFERENCE_PREFIX=
# Conditions proposed when a quote is made.
QUOTE_DEFAULT_CONDITIONS=
