worker_processes auto;
error_log /var/log/nginx/error.log notice;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;

    # What the visitor used, to pass on to the backend. A proxy in front of
    # this one (the platform ingress) has already set these headers and is
    # the one that saw the real scheme and host; without such a proxy the
    # values of this connection are the real ones.
    map $http_x_forwarded_proto $grip_forwarded_proto {
        default $http_x_forwarded_proto;
        ""      $scheme;
    }
    map $http_x_forwarded_host $grip_forwarded_host {
        default $http_x_forwarded_host;
        ""      $http_host;
    }

    # What a page of grip may load and do. Everything comes from this
    # address: scripts, styles, fonts, pictures and the API. No script runs
    # from the page text itself, and no other site can show grip in a frame.
    # 'unsafe-inline' for styles only: the components of the design system
    # and the application set styles on elements. Pictures may be data: and
    # blob: addresses (icons in the styles, a file just chosen).
    map "" $grip_csp {
        default "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";
    }
    map "" $grip_permissions {
        default "camera=(), microphone=(), geolocation=(), payment=(), usb=()";
    }

    # Do not tell which version answers.
    server_tokens off;

    server {
        listen 8080;
        server_name _;

        # The largest thing grip takes in is a document of 10 MB; the backend
        # checks each kind of body more precisely.
        client_max_body_size 13m;

        root /usr/share/nginx/html;
        index index.html;

        # We run behind a reverse proxy on a different port.
        absolute_redirect off;

        # nginx drops these in a location that sets a header of its own,
        # which is why every location below repeats them.
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy $grip_csp always;
        add_header Permissions-Policy $grip_permissions always;

        # The API on the same origin as the frontend: the session and CSRF
        # cookies stay first-party and no CORS configuration is needed.
        # Written at start by docker-api-proxy.sh: a proxy to BACKEND_URL
        # when that is set, a plain 502 when the platform routes /api/ itself.
        # The backend believes the X-Forwarded-* headers only when the
        # address of this container is in its TRUSTED_PROXIES setting.
        include /tmp/grip-api.conf;

        # Where to report a vulnerability; written by the same script from
        # SECURITY_TXT_URL.
        include /tmp/grip-security.conf;

        # Hashed assets: immutable, cache forever.
        location /assets/ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "DENY" always;
            add_header Content-Security-Policy $grip_csp always;
            add_header Permissions-Policy $grip_permissions always;
            try_files $uri =404;
        }

        # The service worker and the manifest: always fetched again, so a
        # new version of the application is picked up.
        location = /sw.js {
            add_header Cache-Control "no-cache";
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "DENY" always;
            add_header Content-Security-Policy $grip_csp always;
            add_header Permissions-Policy $grip_permissions always;
            try_files $uri =404;
        }
        location = /manifest.webmanifest {
            default_type application/manifest+json;
            add_header Cache-Control "no-cache";
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "DENY" always;
            add_header Content-Security-Policy $grip_csp always;
            add_header Permissions-Policy $grip_permissions always;
            try_files $uri =404;
        }

        # SPA fallback. Never cache index.html, so a deploy takes effect.
        location / {
            try_files $uri /index.html;
            add_header Cache-Control "no-cache";
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "DENY" always;
            add_header Content-Security-Policy $grip_csp always;
            add_header Permissions-Policy $grip_permissions always;
            add_header Referrer-Policy "same-origin" always;
        }
    }
}
