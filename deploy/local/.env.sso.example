# Real login with SSO Rijk on this machine.
#
# Copy to .env.sso (gitignored) and fill in the open values. The first time,
# run `just sso-check`: it shows, masked, what SSO Rijk sent and what grip did
# with it. After that `just local-up sso`. See docs/lokaal.md, "Inloggen met
# SSO Rijk".
#
# The platform keeps one shared OIDC client for local development,
# `development-clusters`, in the realm `rig-platform` of the production
# Keycloak. That realm sends you on to SSO Rijk. The client allows redirects
# to http://localhost:*/*, so http://localhost:9001/api/auth/callback fits
# without anyone changing the client.

DEV_NO_AUTH=0
OIDC_ISSUER=https://keycloak.rijksapp.nl/realms/rig-platform
OIDC_CLIENT_ID=development-clusters

# The one secret. A realm admin copies it from the Keycloak admin console:
# realm rig-platform > Clients > development-clusters > Credentials.
OIDC_CLIENT_SECRET=

# Required as soon as login is on. Generate with: openssl rand -hex 32
SESSION_SECRET_KEY=
SESSION_SECRET_KEY_B=

# Your own address as SSO Rijk reports it. Grip only lets in people it
# already knows; this makes you the first beheerder of the local instance.
BOOTSTRAP_BEHEERDER_EMAILS=
