# Component component-1 (frontend) of peer o (ODI voorbeeld) in deployment ${DEPLOYMENT_O} of project ${PROJECT}.
# Image: ghcr.io/<repository>/frontend. Web publication: standard certificate,
# its own host (domain format component-deployment-project). The frontend
# passes /api/ on to the backend of its own deployment, so the browser only
# uses this address. The port is required.
# Fill in with `just zad-fsc-env <deployment>`, which substitutes these
# placeholders and no others:
#   envsubst '${BASE_DOMAIN} ${PROJECT} ${DEPLOYMENT_DIR} ${DEPLOYMENT_A} ${DEPLOYMENT_B} ${DEPLOYMENT_D} ${DEPLOYMENT_E} ${DEPLOYMENT_G} ${DEPLOYMENT_O} ${DEPLOYMENT_Z}'
# The values belong to this component in deployment ${DEPLOYMENT_O}:
# zadctl env add -c <component> --deployment <name> --env-file <file>, and
# env set for a name that layer already has (just zad-fsc-env --existing).

BACKEND_URL=http://${DEPLOYMENT_O}-component-2:8080
# A test environment: its own security.txt, and kept out of search engines.
INSTANCE_MODE=voorbeeld
