# Component dirui in project ${PROJECT_DIR}: the service catalogue of the group.
# Image: docker.io/federatedserviceconnectivity/directory-ui:<OpenFSC version>.
# Web publication: standard certificate (edge), port 8080. No database.
# Attachments: upload/${PROJECT_DIR}/dirui/group-* at /etc/fsc/group/*. The
# UI presents the certificate of the directory manager, so it authenticates
# to the manager as the directory peer.
# Modelled on peers/directory/dirui.env.example in MinBZK/moza-fsc-testnet.
# Placeholders, filled in before the values go into the ZAD Operations Manager:
#   ${BASE_DOMAIN}  ${DEPLOYMENT}  ${PROJECT_DIR}  ${PROJECT_A}  ${PROJECT_B}  ${PROJECT_D}
# (envsubst can do it). $DATABASE_* are substitution variables of ZAD itself
# and stay as they are. In the UI, prefer $DEPLOYMENT_NAME over a fixed
# deployment name so that a second deployment inherits the configuration.

LOG_TYPE=live
LOG_LEVEL=info
GROUP_ID=grip-voorbeeld
LISTEN_ADDRESS=0.0.0.0:8080
MONITORING_ADDRESS=0.0.0.0:8081
BASE_URL_PATH=/
# Byte-identical to DIRECTORY_MANAGER_ADDRESS of dirmgr, or ZAD reports a
# conflicting alias.
DIRECTORY_MANAGER_ADDRESS=https://dirmgr-${DEPLOYMENT}-${PROJECT_DIR}.${BASE_DOMAIN}:443
TLS_GROUP_ROOT_CERT=/etc/fsc/group/ca.pem
TLS_GROUP_CERT=/etc/fsc/group/cert.pem
TLS_GROUP_KEY=/etc/fsc/group/key.pem
