# Component component-2 (backend) of peer b (Voorbeeldministerie) in project ${PROJECT_B}.
# Image: ghcr.io/<repository>/backend. Service: postgresql-database, the same
# database as the federation component. Web publication: standard certificate.
# component-1 (frontend) is not in this file.
# No BOOTSTRAP_BEHEERDER_EMAILS: an example instance refuses it.
#
# Which process needs what:
#   web         FEDERATION_OUTBOUND_ENABLED and OUTWAY_URL (domain events become
#               outbox messages inside web requests)
#   worker      the same, plus FEDERATION_INBOUND_ENABLED and the signing key
#   federation  FEDERATION_INBOUND_ENABLED; only the inway may reach it, so it
#               runs as its own component (federation.env) without web publication
# GRIP_PROCESS=all starts web and the worker, and a listener on 8090 inside the
# pod that nothing reaches; the inway goes to the federation component.
# Placeholders, filled in before the values go into the ZAD Operations Manager:
#   ${BASE_DOMAIN}  ${DEPLOYMENT}  ${PROJECT_DIR}  ${PROJECT_A}  ${PROJECT_B}  ${PROJECT_D}
# (envsubst can do it). $DATABASE_* are substitution variables of ZAD itself
# and stay as they are. In the UI, prefer $DEPLOYMENT_NAME over a fixed
# deployment name so that a second deployment inherits the configuration.

GRIP_PROCESS=all
INSTANCE_MODE=voorbeeld
EXAMPLE_FSC_GROUP=grip-voorbeeld
# Mail domains or addresses that may enter this example instance.
EXAMPLE_VISITORS=<placeholder>
EXAMPLE_RESET_HOUR=3
SEED_DATASET=voorbeeld
INSTANCE_NAME=Voorbeeldministerie
INSTANCE_KEY=voorbeeldministerie
INSTANCE_TOOI_URI=https://identifier.overheid.nl/tooi/id/ministerie/mnre9001
# The public URL of the instance: the frontend component (component-1).
INSTANCE_BASE_URI=https://component-1-${DEPLOYMENT}-${PROJECT_B}.${BASE_DOMAIN}
# Where the other example instances live; the same value on all three.
EXAMPLE_INSTANCE_URIS=digigilde=https://component-1-${DEPLOYMENT}-${PROJECT_A}.${BASE_DOMAIN},ministerie=https://component-1-${DEPLOYMENT}-${PROJECT_B}.${BASE_DOMAIN}
FEDERATION_INBOUND_ENABLED=1
FEDERATION_OUTBOUND_ENABLED=1
OUTWAY_URL=http://${DEPLOYMENT}-outway:8080
# Secret. The same value in component-2 and federation.
FEDERATION_SIGNING_KEY=<placeholder>
# Authentication and the session, as for any deployed instance (docs):
# OIDC_ISSUER, OIDC_CLIENT_ID, OIDC_CLIENT_SECRET, SESSION_SECRET_KEY.
