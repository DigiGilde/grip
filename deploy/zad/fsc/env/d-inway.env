# Component inway of peer d (Voorbeeldprogramma) in project ${PROJECT_D}.
# Image: docker.io/federatedserviceconnectivity/inway:<OpenFSC version>.
# Web publication: TLS mode 2, port 8443 (443 outside). No database.
# Attachments: group-* and internal-* of upload/<project>/inway.
# Placeholders, filled in before the values go into the ZAD Operations Manager:
#   ${BASE_DOMAIN}  ${DEPLOYMENT}  ${PROJECT_DIR}  ${PROJECT_A}  ${PROJECT_B}  ${PROJECT_D}
# (envsubst can do it). $DATABASE_* are substitution variables of ZAD itself
# and stay as they are. In the UI, prefer $DEPLOYMENT_NAME over a fixed
# deployment name so that a second deployment inherits the configuration.
# Addresses between components of one project are written https://<component>:<port>
# (the component name is the host name). The internal certificates carry that
# name as a SAN. Open point: confirm the in-project DNS name on ZAD.

LOG_TYPE=live
LOG_LEVEL=info
NAME=inway-d
GROUP_ID=grip-voorbeeld
# The address outways use; scheme https and port 443.
SELF_ADDRESS=https://inway-${DEPLOYMENT}-${PROJECT_D}.${BASE_DOMAIN}:443
LISTEN_ADDRESS=0.0.0.0:8443
MONITORING_ADDRESS=0.0.0.0:8081
CONTROLLER_REGISTRATION_API_ADDRESS=https://${DEPLOYMENT}-controller:8443
MANAGER_INTERNAL_UNAUTHENTICATED_ADDRESS=https://${DEPLOYMENT}-manager:8445
TX_LOG_API_ADDRESS=https://${DEPLOYMENT}-txlog:8443
TLS_GROUP_ROOT_CERT=/etc/fsc/group/ca.pem
TLS_GROUP_CERT=/etc/fsc/group/cert.pem
TLS_GROUP_KEY=/etc/fsc/group/key.pem
TLS_ROOT_CERT=/etc/fsc/internal/ca.pem
TLS_CERT=/etc/fsc/internal/cert.pem
TLS_KEY=/etc/fsc/internal/key.pem
