# Component inway of peer d (MOZa voorbeeld) in deployment ${DEPLOYMENT_D} of project ${PROJECT}.
# Image: docker.io/federatedserviceconnectivity/inway:<OpenFSC version>.
# Web publication: TLS mode 2, port 8443 (443 outside). No database.
# Attachments: group-* and internal-* of upload/<deployment>/inway.
# Placeholders, filled in before the values go into the ZAD Operations Manager:
#   ${BASE_DOMAIN}  ${PROJECT}  ${DEPLOYMENT_DIR}  ${DEPLOYMENT_A}  ${DEPLOYMENT_B}  ${DEPLOYMENT_D}
# (envsubst can do it). $DATABASE_* are substitution variables of ZAD itself
# and stay as they are. The values belong to this component in deployment
# ${DEPLOYMENT_D}: zadctl env add -c <component> --deployment <name> --env-file <file>.
# Within a deployment a component is reached as <deployment>-<component>:<port>
# (the platform's service name); the internal certificates carry that name as
# a SAN. Between deployments the platform allows no direct traffic: other
# peers are reached on their public host name, port 443.

LOG_TYPE=live
LOG_LEVEL=info
NAME=inway-d
GROUP_ID=grip-voorbeeld
# The address outways use; scheme https and port 443.
SELF_ADDRESS=https://inway-${DEPLOYMENT_D}-${PROJECT}.${BASE_DOMAIN}:443
LISTEN_ADDRESS=0.0.0.0:8443
MONITORING_ADDRESS=0.0.0.0:8081
CONTROLLER_REGISTRATION_API_ADDRESS=https://${DEPLOYMENT_D}-controller:8443
MANAGER_INTERNAL_UNAUTHENTICATED_ADDRESS=https://${DEPLOYMENT_D}-manager:8445
TX_LOG_API_ADDRESS=https://${DEPLOYMENT_D}-txlog:8443
TLS_GROUP_ROOT_CERT=/etc/fsc/group/ca.pem
TLS_GROUP_CERT=/etc/fsc/group/cert.pem
TLS_GROUP_KEY=/etc/fsc/group/key.pem
TLS_ROOT_CERT=/etc/fsc/internal/ca.pem
TLS_CERT=/etc/fsc/internal/cert.pem
TLS_KEY=/etc/fsc/internal/key.pem
