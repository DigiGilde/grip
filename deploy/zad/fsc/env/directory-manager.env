# Component dirmgr in project ${PROJECT_DIR}: the manager of the group in
# directory mode. Image: ghcr.io/<repository>/fsc-manager (wrapper that migrates, then serves).
# Web publication (TLS mode 2, own certificate on the pod): yes, port 8443.
# Service: postgresql-database. Attachments: upload/${PROJECT_DIR}/dirmgr/*
# (group-ca, group-cert, group-key, internal-ca, internal-cert, internal-key),
# mounted at /etc/fsc/group/* and /etc/fsc/internal/*.
# Modelled on peers/directory/manager.env.example in MinBZK/moza-fsc-testnet.
# Placeholders, filled in before the values go into the ZAD Operations Manager:
#   ${BASE_DOMAIN}  ${DEPLOYMENT}  ${PROJECT_DIR}  ${PROJECT_A}  ${PROJECT_B}  ${PROJECT_D}
# (envsubst can do it). $DATABASE_* are substitution variables of ZAD itself
# and stay as they are. In the UI, prefer $DEPLOYMENT_NAME over a fixed
# deployment name so that a second deployment inherits the configuration.

LOG_TYPE=live
LOG_LEVEL=info
GROUP_ID=grip-voorbeeld
DIRECTORY_PEER_ID=01800000000000000099
# These two must be byte-identical: without a transaction log the manager only
# starts when it is its own directory. The port is required (443 or 8443).
SELF_ADDRESS=https://dirmgr-${DEPLOYMENT}-${PROJECT_DIR}.${BASE_DOMAIN}:443
DIRECTORY_MANAGER_ADDRESS=https://dirmgr-${DEPLOYMENT}-${PROJECT_DIR}.${BASE_DOMAIN}:443
TX_LOG_API_ADDRESS=
AUTO_SIGN_GRANTS=servicePublication,delegatedServicePublication
AUDITLOG_TYPE=stdout
# Required since OpenFSC 2.0; the directory has no controller, so the host name
# deliberately does not resolve.
CONTROLLER_REGISTRATION_API_ADDRESS=https://controller.directory.invalid:8443
LISTEN_ADDRESS_EXTERNAL=0.0.0.0:8443
LISTEN_ADDRESS_INTERNAL=0.0.0.0:8444
LISTEN_ADDRESS_INTERNAL_UNAUTHENTICATED=0.0.0.0:8445
MONITORING_ADDRESS=0.0.0.0:8081
STORAGE_POSTGRES_DSN=postgres://$DATABASE_SERVER_USER:$DATABASE_PASSWORD@$DATABASE_SERVER_HOST:5432/$DATABASE_DB?sslmode=disable&connect_timeout=5
TLS_GROUP_ROOT_CERT=/etc/fsc/group/ca.pem
TLS_GROUP_CERT=/etc/fsc/group/cert.pem
TLS_GROUP_KEY=/etc/fsc/group/key.pem
TLS_GROUP_TOKEN_CERT=/etc/fsc/group/cert.pem
TLS_GROUP_TOKEN_KEY=/etc/fsc/group/key.pem
TLS_GROUP_CONTRACT_CERT=/etc/fsc/group/cert.pem
TLS_GROUP_CONTRACT_KEY=/etc/fsc/group/key.pem
TLS_ROOT_CERT=/etc/fsc/internal/ca.pem
TLS_CERT=/etc/fsc/internal/cert.pem
TLS_KEY=/etc/fsc/internal/key.pem
TLS_INTERNAL_UNAUTHENTICATED_ROOT_CERT=/etc/fsc/internal/ca.pem
TLS_INTERNAL_UNAUTHENTICATED_CERT=/etc/fsc/internal/cert.pem
TLS_INTERNAL_UNAUTHENTICATED_KEY=/etc/fsc/internal/key.pem
