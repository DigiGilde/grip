# Component dirmgr in deployment ${DEPLOYMENT_DIR} of project ${PROJECT}: the manager of the group in
# directory mode. Image: ghcr.io/<repository>/fsc-manager (wrapper that migrates, then serves).
# Web publication (TLS mode 2, own certificate on the pod): yes, port 8443.
# Service: postgresql-database. Attachments: upload/${DEPLOYMENT_DIR}/dirmgr/*
# (group-ca, group-cert, group-key, internal-ca, internal-cert, internal-key),
# mounted at /etc/fsc/dir/group/* and /etc/fsc/dir/internal/*.
# Modelled on peers/directory/manager.env.example in MinBZK/moza-fsc-testnet.
# Fill in with `just zad-fsc-env <deployment>`, which substitutes these
# placeholders and no others (a plain envsubst would also empty $DATABASE_*):
#   envsubst '${BASE_DOMAIN} ${PROJECT} ${DEPLOYMENT_DIR} ${DEPLOYMENT_A} ${DEPLOYMENT_B} ${DEPLOYMENT_D} ${DEPLOYMENT_E} ${DEPLOYMENT_G} ${DEPLOYMENT_O} ${DEPLOYMENT_Z}'
# The values belong to this component in deployment ${DEPLOYMENT_DIR}:
# zadctl env add -c <component> --deployment <name> --env-file <file>.

LOG_TYPE=live
LOG_LEVEL=info
GROUP_ID=grip-voorbeeld
DIRECTORY_PEER_ID=01800000000000000099
# These two must be byte-identical: without a transaction log the manager only
# starts when it is its own directory. The port is required (443 or 8443).
SELF_ADDRESS=https://dirmgr-${DEPLOYMENT_DIR}-${PROJECT}.${BASE_DOMAIN}:443
DIRECTORY_MANAGER_ADDRESS=https://dirmgr-${DEPLOYMENT_DIR}-${PROJECT}.${BASE_DOMAIN}:443
TX_LOG_API_ADDRESS=
AUTO_SIGN_GRANTS=servicePublication,delegatedServicePublication
AUDITLOG_TYPE=stdout
# Required since OpenFSC 2.0; the directory has no controller, so the host name
# deliberately does not resolve.
CONTROLLER_REGISTRATION_API_ADDRESS=https://controller.directory.invalid:8443
LISTEN_ADDRESS_EXTERNAL=0.0.0.0:8443
LISTEN_ADDRESS_INTERNAL=0.0.0.0:8444
LISTEN_ADDRESS_INTERNAL_UNAUTHENTICATED=0.0.0.0:8445
MONITORING_ADDRESS=0.0.0.0:8081
# An alias, not an env var: the platform fills $DATABASE_* in an alias only.
# The recipe writes this line to <component>.alias, for zadctl alias add -c
# <component> --env-file <file>; one alias serves every deployment.
STORAGE_POSTGRES_DSN=postgres://$DATABASE_SERVER_USER:$DATABASE_PASSWORD@$DATABASE_SERVER_HOST:$DATABASE_SERVER_PORT/$DATABASE_DB?sslmode=require&connect_timeout=5
TLS_GROUP_ROOT_CERT=/etc/fsc/dir/group/ca.pem
TLS_GROUP_CERT=/etc/fsc/dir/group/cert.pem
TLS_GROUP_KEY=/etc/fsc/dir/group/key.pem
TLS_GROUP_TOKEN_CERT=/etc/fsc/dir/group/cert.pem
TLS_GROUP_TOKEN_KEY=/etc/fsc/dir/group/key.pem
TLS_GROUP_CONTRACT_CERT=/etc/fsc/dir/group/cert.pem
TLS_GROUP_CONTRACT_KEY=/etc/fsc/dir/group/key.pem
TLS_ROOT_CERT=/etc/fsc/dir/internal/ca.pem
TLS_CERT=/etc/fsc/dir/internal/cert.pem
TLS_KEY=/etc/fsc/dir/internal/key.pem
TLS_INTERNAL_UNAUTHENTICATED_ROOT_CERT=/etc/fsc/dir/internal/ca.pem
TLS_INTERNAL_UNAUTHENTICATED_CERT=/etc/fsc/dir/internal/cert.pem
TLS_INTERNAL_UNAUTHENTICATED_KEY=/etc/fsc/dir/internal/key.pem
