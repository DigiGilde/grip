# Component component-2 (backend) of peer a (DigiGilde voorbeeld) in deployment ${DEPLOYMENT_A} of project ${PROJECT}.
# Image: ghcr.io/<repository>/backend. Service: postgresql-database, the same
# database as the federation component. Web publication: standard certificate.
# component-1 (frontend) is not in this file.
# No BOOTSTRAP_BEHEERDER_EMAILS: an example instance refuses it.
#
# Which process needs what:
#   web         FEDERATION_OUTBOUND_ENABLED and OUTWAY_URL (domain events become
#               outbox messages inside web requests)
#   worker      the same, plus FEDERATION_INBOUND_ENABLED and the signing key
#   federation  FEDERATION_INBOUND_ENABLED; only the inway may reach it, so it
#               runs as its own component (federation.env) without web publication
# GRIP_PROCESS=all starts web and the worker, and a listener on 8090 inside the
# pod that nothing reaches; the inway goes to the federation component.
# Fill in with `just zad-fsc-env <deployment>`, which substitutes these
# placeholders and no others:
#   envsubst '${BASE_DOMAIN} ${PROJECT} ${DEPLOYMENT_DIR} ${DEPLOYMENT_A} ${DEPLOYMENT_B} ${DEPLOYMENT_D} ${DEPLOYMENT_E} ${DEPLOYMENT_G} ${DEPLOYMENT_O} ${DEPLOYMENT_Z}'
# The values belong to this component in deployment ${DEPLOYMENT_A}:
# zadctl env add -c <component> --deployment <name> --env-file <file>, and
# env set for a name that layer already has (just zad-fsc-env --existing).

GRIP_PROCESS=all
INSTANCE_MODE=voorbeeld
EXAMPLE_FSC_GROUP=grip-voorbeeld
# Not in this file: EXAMPLE_VISITORS, the mail domains or addresses that may
# enter. It can name people, and it is set once on component-2 for every
# example instance.
EXAMPLE_RESET_HOUR=3
SEED_DATASET=voorbeeld
INSTANCE_NAME=DigiGilde voorbeeld
INSTANCE_KEY=digigilde-voorbeeld
# Here, not on component-2 itself, where it would apply to every instance.
ORGANISATION_NAME=DigiGilde voorbeeld
INSTANCE_TOOI_URI=https://identifier.overheid.nl/tooi/id/oorg/oorg99002
# The public URL of the instance: the frontend component (component-1).
INSTANCE_BASE_URI=https://component-1-${DEPLOYMENT_A}-${PROJECT}.${BASE_DOMAIN}
# Where the other example instances live; the same value on all seven.
EXAMPLE_INSTANCE_URIS=digigilde=https://component-1-${DEPLOYMENT_A}-${PROJECT}.${BASE_DOMAIN},ministerie=https://component-1-${DEPLOYMENT_B}-${PROJECT}.${BASE_DOMAIN},programma=https://component-1-${DEPLOYMENT_D}-${PROJECT}.${BASE_DOMAIN},nldd=https://component-1-${DEPLOYMENT_E}-${PROJECT}.${BASE_DOMAIN},gdi=https://component-1-${DEPLOYMENT_G}-${PROJECT}.${BASE_DOMAIN},odi=https://component-1-${DEPLOYMENT_O}-${PROJECT}.${BASE_DOMAIN},ezk=https://component-1-${DEPLOYMENT_Z}-${PROJECT}.${BASE_DOMAIN}
FEDERATION_INBOUND_ENABLED=1
FEDERATION_OUTBOUND_ENABLED=1
OUTWAY_URL=http://${DEPLOYMENT_A}-outway:8080
# Secrets, not in this file; set them through stdin (docs/uitrol-zad.md):
# FEDERATION_SIGNING_KEY=<the key of this instance, the same value on federation>
# SESSION_SECRET_KEY=<openssl rand -hex 32; a new instance needs its own, or it
# takes the one set on component-2 itself>
# PEER_REGISTRY_KEY=<openssl rand -hex 32, a value of its own; the same value on
# the bootstrap fscboot-<k> of this deployment, which writes the peer registry>
# Authentication, as for any deployed instance (docs): OIDC_ISSUER,
# OIDC_CLIENT_ID, OIDC_CLIENT_SECRET.
