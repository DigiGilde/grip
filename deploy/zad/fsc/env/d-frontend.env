# Component component-1 (frontend) of peer d (MOZa voorbeeld) in deployment ${DEPLOYMENT_D} of project ${PROJECT}.
# Image: ghcr.io/<repository>/frontend. Web publication: standard certificate,
# its own host (domain format component-deployment-project). The frontend
# passes /api/ on to the backend of its own deployment, so the browser only
# uses this address. The port is required.
# Placeholders, filled in before the values go into the ZAD Operations Manager:
#   ${BASE_DOMAIN}  ${PROJECT}  ${DEPLOYMENT_DIR}  ${DEPLOYMENT_A}  ${DEPLOYMENT_B}  ${DEPLOYMENT_D}
# (envsubst can do it). The values belong to this component in deployment
# ${DEPLOYMENT_D}: zadctl env add -c <component> --deployment <name> --env-file <file>.

BACKEND_URL=http://${DEPLOYMENT_D}-component-2:8080
# A test environment: its own security.txt, and kept out of search engines.
INSTANCE_MODE=voorbeeld
