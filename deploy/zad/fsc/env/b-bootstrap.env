# Component fscboot-b of peer b (Ministerie van BZK voorbeeld) in deployment ${DEPLOYMENT_B} of project ${PROJECT}:
# the bootstrap of the peer (bootstrap.sh), next to its manager and
# controller, whose internal APIs on port 8444 nothing outside the deployment
# reaches. It registers and publishes the service of this instance, asks for
# a connection to the service of every peer it is related to, writes those
# peers into the peer registry of grip and tests each connection.
# Image: ghcr.io/<repository>/fsc-bootstrap. No port and not published.
# Services: attachments, for the files below, and health-check with scheme
# none, as nothing listens. Attachments: internal-* of upload/<deployment>/fscboot-b at
# /etc/fsc/b/internal/* (the internal CA and the admin client certificate).
# Fill in with `just zad-fsc-env <deployment>`, which substitutes these
# placeholders and no others:
#   envsubst '${BASE_DOMAIN} ${PROJECT} ${DEPLOYMENT_DIR} ${DEPLOYMENT_A} ${DEPLOYMENT_B} ${DEPLOYMENT_D} ${DEPLOYMENT_E} ${DEPLOYMENT_G} ${DEPLOYMENT_O} ${DEPLOYMENT_Z}'
# The values belong to the component itself, not to its layer in deployment
# ${DEPLOYMENT_B}: the component runs only there, and its first deploy must
# find them. zadctl env add -c fscboot-b --env-file <file>, without --deployment.

PEER=b
# The peers of the group.
PEERS=a b d e g o z
BASE_DOMAIN=${BASE_DOMAIN}
PROJECT=${PROJECT}
DEPLOYMENT_A=${DEPLOYMENT_A}
DEPLOYMENT_B=${DEPLOYMENT_B}
DEPLOYMENT_D=${DEPLOYMENT_D}
DEPLOYMENT_E=${DEPLOYMENT_E}
DEPLOYMENT_G=${DEPLOYMENT_G}
DEPLOYMENT_O=${DEPLOYMENT_O}
DEPLOYMENT_Z=${DEPLOYMENT_Z}
# Where grip of this deployment answers; the default is below.
# GRIP_URL=http://${DEPLOYMENT_B}-component-2:8080
# Secret, not in this file; set it through stdin (docs/uitrol-zad.md), with the
# same value as on component-2 of this deployment:
# PEER_REGISTRY_KEY=<the value of component-2>
TLS_ROOT_CERT=/etc/fsc/b/internal/ca.pem
TLS_CERT=/etc/fsc/b/internal/cert.pem
TLS_KEY=/etc/fsc/b/internal/key.pem
