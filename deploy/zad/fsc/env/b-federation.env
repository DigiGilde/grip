# Component federation of peer b (Ministerie van BZK voorbeeld) in deployment ${DEPLOYMENT_B} of project ${PROJECT}: the routes
# other instances call, behind the inway.
# Image: ghcr.io/<repository>/backend. Service: postgresql-database, the same
# database as component-2. Not published on the web: only the inway reaches
# port 8090. The service endpoint registered in the controller is
# http://${DEPLOYMENT_B}-federation:8090.
# Migrations run in component-2 only.
# Placeholders, filled in before the values go into the ZAD Operations Manager:
#   ${BASE_DOMAIN}  ${PROJECT}  ${DEPLOYMENT_DIR}  ${DEPLOYMENT_A}  ${DEPLOYMENT_B}  ${DEPLOYMENT_D}
# (envsubst can do it). $DATABASE_* are substitution variables of ZAD itself
# and stay as they are. The values belong to this component in deployment
# ${DEPLOYMENT_B}: zadctl env add -c <component> --deployment <name> --env-file <file>.

GRIP_PROCESS=federation
RUN_MIGRATIONS=0
INSTANCE_MODE=voorbeeld
EXAMPLE_FSC_GROUP=grip-voorbeeld
# Mail domains or addresses that may enter this example instance.
EXAMPLE_VISITORS=<placeholder>
EXAMPLE_RESET_HOUR=3
SEED_DATASET=voorbeeld
INSTANCE_NAME=Ministerie van BZK voorbeeld
INSTANCE_KEY=voorbeeldministerie
INSTANCE_TOOI_URI=https://identifier.overheid.nl/tooi/id/ministerie/mnre9001
# The public URL of the instance: the frontend component (component-1).
INSTANCE_BASE_URI=https://component-1-${DEPLOYMENT_B}-${PROJECT}.${BASE_DOMAIN}
# Where the other example instances live; the same value on all three.
EXAMPLE_INSTANCE_URIS=digigilde=https://component-1-${DEPLOYMENT_A}-${PROJECT}.${BASE_DOMAIN},ministerie=https://component-1-${DEPLOYMENT_B}-${PROJECT}.${BASE_DOMAIN}
FEDERATION_INBOUND_ENABLED=1
FEDERATION_OUTBOUND_ENABLED=1
OUTWAY_URL=http://${DEPLOYMENT_B}-outway:8080
# Secret. The same value in component-2 and federation.
FEDERATION_SIGNING_KEY=<placeholder>
