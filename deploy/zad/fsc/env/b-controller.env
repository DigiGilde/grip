# Component controller of peer b (Ministerie van BZK voorbeeld) in deployment ${DEPLOYMENT_B} of project ${PROJECT}.
# Image: fsc-controller (wrapper). Not published on the web: the UI (port 3000)
# runs without login (AUTHN_TYPE none) and must stay unreachable from outside.
# Service: postgresql-database. Attachments: internal-* of
# upload/<deployment>/controller at /etc/fsc/b/internal/*.
# Fill in with `just zad-fsc-env <deployment>`, which substitutes these
# placeholders and no others (a plain envsubst would also empty $DATABASE_*):
#   envsubst '${BASE_DOMAIN} ${PROJECT} ${DEPLOYMENT_DIR} ${DEPLOYMENT_A} ${DEPLOYMENT_B} ${DEPLOYMENT_D}'
# The values belong to this component in deployment ${DEPLOYMENT_B}:
# zadctl env add -c <component> --deployment <name> --env-file <file>.
# Within a deployment a component is reached as <deployment>-<component>:<port>
# (the platform's service name); the internal certificates carry that name as
# a SAN. Between deployments the platform allows no direct traffic: other
# peers are reached on their public host name, port 443.

LOG_TYPE=live
LOG_LEVEL=info
GROUP_ID=grip-voorbeeld
DIRECTORY_PEER_ID=01800000000000000099
MANAGER_ADDRESS_INTERNAL=https://${DEPLOYMENT_B}-manager:8444
LISTEN_ADDRESS_UI=0.0.0.0:3000
LISTEN_ADDRESS_REGISTRATION_API=0.0.0.0:8443
LISTEN_ADDRESS_ADMINISTRATION_API=0.0.0.0:8444
MONITORING_ADDRESS=0.0.0.0:8081
AUDITLOG_TYPE=stdout
# An alias, not an env var: the platform fills $DATABASE_* in an alias only.
# The recipe writes this line to <component>.alias, for zadctl alias add -c
# <component> --env-file <file>; one alias serves every deployment.
STORAGE_POSTGRES_DSN=postgres://$DATABASE_SERVER_USER:$DATABASE_PASSWORD@$DATABASE_SERVER_HOST:5432/$DATABASE_DB?sslmode=disable&connect_timeout=5
TLS_ROOT_CERT=/etc/fsc/b/internal/ca.pem
TLS_CERT=/etc/fsc/b/internal/cert.pem
TLS_KEY=/etc/fsc/b/internal/key.pem
