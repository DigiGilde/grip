# Component txlog of peer b (Voorbeeldministerie) in deployment ${DEPLOYMENT_B} of project ${PROJECT}.
# Image: fsc-txlog (wrapper). Not published on the web.
# Service: postgresql-database. Attachments: internal-* of upload/<deployment>/txlog.
# Placeholders, filled in before the values go into the ZAD Operations Manager:
#   ${BASE_DOMAIN}  ${PROJECT}  ${DEPLOYMENT_DIR}  ${DEPLOYMENT_A}  ${DEPLOYMENT_B}  ${DEPLOYMENT_D}
# (envsubst can do it). $DATABASE_* are substitution variables of ZAD itself
# and stay as they are. The values belong to this component in deployment
# ${DEPLOYMENT_B}: zadctl env add -c <component> --deployment <name> --env-file <file>.
# Within a deployment a component is reached as <deployment>-<component>:<port>
# (the platform's service name); the internal certificates carry that name as
# a SAN. Between deployments the platform allows no direct traffic: other
# peers are reached on their public host name, port 443.

LOG_TYPE=live
LOG_LEVEL=info
LISTEN_ADDRESS=0.0.0.0:8443
MONITORING_ADDRESS=0.0.0.0:8081
STORAGE_POSTGRES_DSN=postgres://$DATABASE_SERVER_USER:$DATABASE_PASSWORD@$DATABASE_SERVER_HOST:5432/$DATABASE_DB?sslmode=disable&connect_timeout=5
TLS_ROOT_CERT=/etc/fsc/internal/ca.pem
TLS_CERT=/etc/fsc/internal/cert.pem
TLS_KEY=/etc/fsc/internal/key.pem
