# Component manager of peer b (Voorbeeldministerie) in deployment ${DEPLOYMENT_B} of project ${PROJECT}.
# Image: fsc-manager (wrapper). Web publication: TLS mode 2, port 8443.
# Service: postgresql-database. Attachments: group-* and internal-* of
# upload/<deployment>/manager at /etc/fsc/group/* and /etc/fsc/internal/*.
# Placeholders, filled in before the values go into the ZAD Operations Manager:
#   ${BASE_DOMAIN}  ${PROJECT}  ${DEPLOYMENT_DIR}  ${DEPLOYMENT_A}  ${DEPLOYMENT_B}  ${DEPLOYMENT_D}
# (envsubst can do it). $DATABASE_* are substitution variables of ZAD itself
# and stay as they are. The values belong to this component in deployment
# ${DEPLOYMENT_B}: zadctl env add -c <component> --deployment <name> --env-file <file>.
# Within a deployment a component is reached as <deployment>-<component>:<port>
# (the platform's service name); the internal certificates carry that name as
# a SAN. Between deployments the platform allows no direct traffic: other
# peers are reached on their public host name, port 443.

LOG_TYPE=live
LOG_LEVEL=info
GROUP_ID=grip-voorbeeld
DIRECTORY_PEER_ID=01800000000000000099
DIRECTORY_MANAGER_ADDRESS=https://dirmgr-${DEPLOYMENT_DIR}-${PROJECT}.${BASE_DOMAIN}:443
# The port is required and must be the mesh port 443.
SELF_ADDRESS=https://manager-${DEPLOYMENT_B}-${PROJECT}.${BASE_DOMAIN}:443
TX_LOG_API_ADDRESS=https://${DEPLOYMENT_B}-txlog:8443
CONTROLLER_REGISTRATION_API_ADDRESS=https://${DEPLOYMENT_B}-controller:8443
AUDITLOG_TYPE=stdout
LISTEN_ADDRESS_EXTERNAL=0.0.0.0:8443
LISTEN_ADDRESS_INTERNAL=0.0.0.0:8444
LISTEN_ADDRESS_INTERNAL_UNAUTHENTICATED=0.0.0.0:8445
MONITORING_ADDRESS=0.0.0.0:8081
STORAGE_POSTGRES_DSN=postgres://$DATABASE_SERVER_USER:$DATABASE_PASSWORD@$DATABASE_SERVER_HOST:5432/$DATABASE_DB?sslmode=disable&connect_timeout=5
TLS_GROUP_ROOT_CERT=/etc/fsc/group/ca.pem
TLS_GROUP_CERT=/etc/fsc/group/cert.pem
TLS_GROUP_KEY=/etc/fsc/group/key.pem
TLS_GROUP_TOKEN_CERT=/etc/fsc/group/cert.pem
TLS_GROUP_TOKEN_KEY=/etc/fsc/group/key.pem
TLS_GROUP_CONTRACT_CERT=/etc/fsc/group/cert.pem
TLS_GROUP_CONTRACT_KEY=/etc/fsc/group/key.pem
TLS_ROOT_CERT=/etc/fsc/internal/ca.pem
TLS_CERT=/etc/fsc/internal/cert.pem
TLS_KEY=/etc/fsc/internal/key.pem
TLS_INTERNAL_UNAUTHENTICATED_ROOT_CERT=/etc/fsc/internal/ca.pem
TLS_INTERNAL_UNAUTHENTICATED_CERT=/etc/fsc/internal/cert.pem
TLS_INTERNAL_UNAUTHENTICATED_KEY=/etc/fsc/internal/key.pem
