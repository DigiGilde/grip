# Component outway of peer e (NLDD voorbeeld) in deployment ${DEPLOYMENT_E} of project ${PROJECT}.
# Image: docker.io/federatedserviceconnectivity/outway:<OpenFSC version>.
# Not published on the web: only grip calls it, on http://${DEPLOYMENT_E}-outway:8080. No database.
# Attachments: group-* and internal-* of upload/<deployment>/outway.
# Fill in with `just zad-fsc-env <deployment>`, which substitutes these
# placeholders and no others:
#   envsubst '${BASE_DOMAIN} ${PROJECT} ${DEPLOYMENT_DIR} ${DEPLOYMENT_A} ${DEPLOYMENT_B} ${DEPLOYMENT_D} ${DEPLOYMENT_E} ${DEPLOYMENT_G} ${DEPLOYMENT_O} ${DEPLOYMENT_Z}'
# The values belong to this component in deployment ${DEPLOYMENT_E}:
# zadctl env add -c <component> --deployment <name> --env-file <file>.
# Within a deployment a component is reached as <deployment>-<component>:<port>
# (the platform's service name); the internal certificates carry that name as
# a SAN. Between deployments the platform allows no direct traffic: other
# peers are reached on their public host name, port 443.

LOG_TYPE=live
LOG_LEVEL=info
NAME=outway-e
GROUP_ID=grip-voorbeeld
LISTEN_ADDRESS=0.0.0.0:8080
MONITORING_ADDRESS=0.0.0.0:8081
TX_LOG_API_ADDRESS=https://${DEPLOYMENT_E}-txlog:8443
CONTROLLER_REGISTRATION_API_ADDRESS=https://${DEPLOYMENT_E}-controller:8443
MANAGER_INTERNAL_ADDRESS=https://${DEPLOYMENT_E}-manager:8444
ENABLE_GRANT_HASH_SUGGESTION=true
TLS_GROUP_ROOT_CERT=/etc/fsc/e/group/ca.pem
TLS_GROUP_CERT=/etc/fsc/e/group/cert.pem
TLS_GROUP_KEY=/etc/fsc/e/group/key.pem
TLS_ROOT_CERT=/etc/fsc/e/internal/ca.pem
TLS_CERT=/etc/fsc/e/internal/cert.pem
TLS_KEY=/etc/fsc/e/internal/key.pem
