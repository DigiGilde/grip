---
import Base from '../layouts/Base.astro';
import BrandMark from '../components/BrandMark.astro';
import { PRODUCT_NAME, PRODUCT_SENTENCE, ROUTES, SITE_NAME } from '../lib/site';
---

<Base>
  <nldd-simple-section padding-bottom="0">
    <nldd-container slot="header">
      <div class="brand">
        <BrandMark size={40} />
        <div class="brand-lines">
          <span class="brand-word">{PRODUCT_NAME}</span>
          <span class="brand-quiet">{PRODUCT_SENTENCE}</span>
        </div>
      </div>
      <nldd-spacer size="24"></nldd-spacer>
      <nldd-title size="display-1" heading-level="1" text={SITE_NAME}></nldd-title>
      <nldd-spacer size="16"></nldd-spacer>
      <nldd-rich-text>
        <p>
          De documentatie, de besluiten en de persona’s van grip op één plek, met zoeken over alles. Deze site is
          geen onderdeel van grip en bewaart geen gegevens.
        </p>
      </nldd-rich-text>
      <nldd-spacer size="16"></nldd-spacer>
      <nldd-button-group orientation="horizontal">
        <nldd-button appearance="neutral-tinted" href={ROUTES.docs} text="Documentatie"></nldd-button>
        <nldd-button appearance="neutral-tinted" href={ROUTES.adr} text="Besluiten"></nldd-button>
        <nldd-button appearance="neutral-tinted" href={ROUTES.book} text="Personaboek"></nldd-button>
      </nldd-button-group>
    </nldd-container>
  </nldd-simple-section>

  {/* Filled from /config.json at runtime; stays hidden when no instance is configured. */}
  <nldd-simple-section id="demo" hidden>
    <nldd-container slot="header">
      <nldd-title size="display-4" heading-level="2" text="Demo"></nldd-title>
      <nldd-spacer size="16"></nldd-spacer>
      <nldd-rich-text>
        <p>
          Instanties van grip met verzonnen gegevens. Open er een en kies in het accountmenu een
          voorbeeldpersoon; wie welke rol heeft, staat in het <a href={ROUTES.book}>Personaboek</a>.
        </p>
      </nldd-rich-text>
    </nldd-container>
    <nldd-collection id="demo-instanties" layout="grid" item-min-width="280px"></nldd-collection>
  </nldd-simple-section>
</Base>
