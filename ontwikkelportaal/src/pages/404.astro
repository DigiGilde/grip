---
import Base from '../layouts/Base.astro';
import { ROUTES } from '../lib/site';
---

<Base title="Pagina niet gevonden">
  <nldd-simple-section>
    <nldd-inline-dialog
      icon="signpost"
      heading-level="1"
      text="Deze pagina bestaat niet"
      supporting-text="Misschien is ze verplaatst. Zoek haar op, of begin bij de start."
    >
      <nldd-button slot="actions" appearance="secondary" text="Zoeken" href={ROUTES.search}></nldd-button>
      <nldd-button slot="actions" appearance="secondary" text="Naar de start" href={ROUTES.start}></nldd-button>
    </nldd-inline-dialog>
  </nldd-simple-section>
</Base>
